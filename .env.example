API_KEY=local-development-key

# Connection URLs for running Python on your host.
# Docker Compose builds its own URLs using the passwords below.
DATABASE_URL=postgresql+asyncpg://pays:pays@localhost:5432/pays
RABBITMQ_URL=amqp://pays:pays@localhost:5672/

# Credentials for the PostgreSQL and RabbitMQ services in Docker Compose.
POSTGRES_PASSWORD=pays
RABBITMQ_PASSWORD=pays

# Optional application settings; these values are the defaults.
WEBHOOK_TIMEOUT_SECONDS=10
OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=50
PUBLISH_TIMEOUT_SECONDS=10
